# Existing backend (keep configured until Appwrite cutover is validated).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Appwrite migration target. Public values identify the project only.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=

# Server-only values. Never prefix secrets with NEXT_PUBLIC_.
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=
APPWRITE_BUCKET_PROFILE_PICTURES=
APPWRITE_BUCKET_MEDIA=

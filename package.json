{
  "name": "dalimgari",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dalimgari community website",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:syntax": "node --check app.js && node --check header.js",
    "test": "node --test tests/*.test.cjs",
    "check": "npm run check:syntax && npm run test:unit && npm test",
    "lint": "eslint src tests",
    "format:check": "prettier --check src tests *.ts *.js *.json *.html",
    "test:e2e": "playwright test",
    "test:unit": "node --test tests/unit/*.test.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.35.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.0",
    "vite": "7.1.5",
    "@eslint/js": "9.35.0"
  }
}
